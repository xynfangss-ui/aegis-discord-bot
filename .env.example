TOKEN=your_bot_token
# DISCORD_TOKEN is also supported.
# Optional: register slash commands instantly to one server while testing.
DISCORD_GUILD_ID=your_server_id
# Optional: role that can see and answer private ticket channels.
TICKET_ROLE_ID=your_support_role_id
# Optional: use this role for additional staff access to managed channels.
MOD_ROLE_ID=your_moderator_role_id
# Railway provides PORT automatically. The bot uses it for its health endpoint.
