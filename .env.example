TOKEN=your_bot_token
# DISCORD_TOKEN is also supported.
# Optional: register slash commands instantly to one server while testing.
DISCORD_GUILD_ID=your_server_id
# Optional: role that can see and answer private ticket channels.
TICKET_ROLE_ID=your_support_role_id
# Optional: use this role for additional staff access to managed channels.
MOD_ROLE_ID=your_moderator_role_id
# Railway provides PORT automatically. The bot uses it for its health endpoint.

# Roblox/community command configuration
ROBLOX_GROUP_ID=your_roblox_group_id
ROBLOX_GROUP_URL=https://www.roblox.com/communities/your_group_id
ROBUX_ITEM_1_NAME=TNM Access Shirt 1
ROBUX_ITEM_1_PRICE=Not configured
ROBUX_ITEM_1_ID=your_asset_id
ROBUX_ITEM_1_URL=https://www.roblox.com/catalog/your_asset_id
ROBUX_ITEM_2_NAME=TNM Access Shirt 2
ROBUX_ITEM_2_PRICE=Not configured
ROBUX_ITEM_2_ID=your_asset_id
ROBUX_ITEM_2_URL=https://www.roblox.com/catalog/your_asset_id
ROBUX_ITEM_3_NAME=TNM Access Shirt 3
ROBUX_ITEM_3_PRICE=Not configured
ROBUX_ITEM_3_ID=your_asset_id
ROBUX_ITEM_3_URL=https://www.roblox.com/catalog/your_asset_id
VENMO_USERNAME=your_venmo
CASHAPP_USERNAME=your_cashapp
PAYPAL_USERNAME=your_paypal
ZELLE_CONTACT=your_zelle_contact
